# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose this to the client. Used by server actions to
# upload/mirror images to storage, and to invite new accounts (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The email address of the app's owner account. This account can invite
# other accounts (signup is invite-only) and is used for the one-time
# bootstrap invite on first setup.
OWNER_EMAIL=you@example.com

# Set to "true" to let anyone sign up via Google/Apple without being on the
# invite allowlist first. Leave unset (or anything other than "true") to
# keep the app invite-only, including for OAuth sign-in.
OPEN_SIGNUP=false
