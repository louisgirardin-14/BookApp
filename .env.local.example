# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose this to the client. Used by server actions/routes
# to write to the books table and upload covers, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Simple shared-password gate for this single-user app.
# Set this to any password you choose.
APP_PASSWORD=change-me
